@model SistemaLegalPagares.Models.Expediente

@{
    ViewData["Title"] = "Nuevo Expediente";
}

<div class="container mt-5">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                Nuevo Expediente
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="NumeroExpediente" class="form-label"></label>
                        <input asp-for="NumeroExpediente" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="NombreCliente" class="form-label"></label>
                        <input asp-for="NombreCliente" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="CURP" class="form-label"></label>
                        <input asp-for="CURP" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="RFC" class="form-label"></label>
                        <input asp-for="RFC" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="INE" class="form-label"></label>
                        <input asp-for="INE" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Direccion" class="form-label"></label>
                        <input asp-for="Direccion" class="form-control" />
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Observaciones" class="form-label"></label>
                        <textarea asp-for="Observaciones"
                                  class="form-control"
                                  rows="4"></textarea>
                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        ← Regresar
                    </a>

                    <button type="submit"
                            class="btn btn-success">
                         Guardar Expediente
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}