@model SistemaLegalPagares.Models.Expediente

@{
    ViewData["Title"] = "Detalle del Expediente";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Expediente @Model.NumeroExpediente</h2>
            <p class="text-muted mb-0">
                Información general del expediente legal
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            Volver
        </a>
    </div>

    <div class="row">

        <!-- INFORMACIÓN DEL EXPEDIENTE -->
        <div class="col-md-5 mb-4">

            <div class="card shadow border-0 h-100">

                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Datos del Expediente</h5>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <small class="text-muted">Número de expediente</small>
                        <div class="fw-bold fs-5">
                            @Model.NumeroExpediente
                        </div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Fecha de creación</small>
                        <div>
                            @Model.FechaCreacion.ToString("dd/MM/yyyy")
                        </div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Observaciones</small>
                        <div class="border rounded p-3 bg-light">
                            @(string.IsNullOrWhiteSpace(Model.Observaciones)
                                ? "Sin observaciones registradas."
                                : Model.Observaciones)
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- INFORMACIÓN DEL CLIENTE -->
        <div class="col-md-7 mb-4">

            <div class="card shadow border-0 h-100">

                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Cliente Asociado</h5>
                </div>

                <div class="card-body">

                    @if (Model.Cliente != null)
                    {
                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <small class="text-muted">Nombre completo</small>
                            <div class="fw-bold">
                                @Model.Cliente.NombreCompleto
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <small class="text-muted">RFC</small>
                            <div>
                                @(Model.Cliente.RFC ?? "Sin RFC")
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <small class="text-muted">CURP</small>
                            <div>
                                @(Model.Cliente.CURP ?? "Sin CURP")
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <small class="text-muted">INE</small>
                            <div>
                                @(Model.Cliente.INE ?? "Sin INE")
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <small class="text-muted">Teléfono</small>
                            <div>
                                @(Model.Cliente.Telefono ?? "Sin teléfono")
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <small class="text-muted">Correo</small>
                            <div>
                                @(Model.Cliente.Correo ?? "Sin correo")
                            </div>
                        </div>

                        <div class="col-12 mb-3">
                            <small class="text-muted">Dirección</small>
                            <div class="border rounded p-3 bg-light">
                                @(Model.Cliente.Direccion ?? "Sin dirección")
                            </div>
                        </div>

                    </div>
                    }
                    else
                    {
                    <div class="alert alert-warning mb-0">
                        Este expediente todavía no tiene cliente asociado.
                    </div>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- PAGARÉS ASOCIADOS -->
    <div class="card shadow border-0 mt-3">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

            <h5 class="mb-0">Pagarés del Expediente</h5>

            <a asp-controller="Pagares"
               asp-action="Create"
               asp-route-expedienteId="@Model.Id"
               class="btn btn-light btn-sm">
                Crear Pagaré
            </a>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>No. Pagaré</th>
                            <th>Acreedor</th>
                            <th>Monto Total</th>
                            <th>Fecha Expedición</th>
                            <th>Serie</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Pagares == null || !Model.Pagares.Any())
                        {
                        <tr>
                            <td colspan="6" class="text-center p-4 text-muted">
                                Aún no hay pagarés registrados para este expediente.
                            </td>
                        </tr>
                        }
                        else
                        {
                            foreach (var pagare in Model.Pagares)
                            {
                        <tr>
                            <td>
                                @(pagare.NumeroPagare ?? "Sin número")
                            </td>

                            <td>
                                @pagare.Acreedor
                            </td>

                            <td class="fw-bold text-success">
                                $@pagare.MontoTotal.ToString("N2")
                            </td>

                            <td>
                                @pagare.FechaExpedicion.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @pagare.SerieDesde de @pagare.SerieHasta
                            </td>

                            <td>
                                <a asp-controller="Pagares"
                                   asp-action="Details"
                                   asp-route-id="@pagare.Id"
                                   class="btn btn-info btn-sm text-white">
                                    Ver
                                </a>

                                <a asp-controller="Pagares"
                                   asp-action="Details"
                                   asp-route-id="@pagare.Id"
                                   class="btn btn-danger btn-sm">
                                    PDF / Imprimir
                                </a>
                            </td>
                        </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <div class="mt-4 d-flex justify-content-between">

        <a asp-action="Index" class="btn btn-secondary">
            Volver a expedientes
        </a>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Editar Expediente
        </a>

    </div>

</div>