@model IEnumerable<SistemaLegalPagares.Models.Expediente>

    @{
    ViewData["Title"] = "Expedientes";
    }

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold">Expedientes</h2>
                <p class="text-muted mb-0">
                    Administración de carpetas legales y pagarés asociados
                </p>
            </div>

            <a asp-action="Create" class="btn btn-success">
                + Nuevo Expediente
            </a>
        </div>

        <div class="card shadow border-0">

            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Listado de Expedientes</h5>
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Número de Expediente</th>
                                <th>Cliente</th>
                                <th>Fecha de Creación</th>
                                <th class="text-center" width="240">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center p-4 text-muted">
                                    No hay expedientes registrados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                            <tr>
                                <td>
                                    <span class="fw-bold">
                                        @item.NumeroExpediente
                                    </span>
                                </td>

                                <td>
                                    @if (item.Cliente != null)
                                        {
                                    <span>@item.Cliente.NombreCompleto</span>
                                        }
                                        else
                                        {
                                    <span class="text-muted">Sin cliente asociado</span>
                                        }
                                </td>

                                <td>
                                    @item.FechaCreacion.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-center">
                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white">
                                            Ver detalles
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">
                                            Editar
                                        </a>

                                    </div>
                                </td>
                            </tr>
                            }
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
