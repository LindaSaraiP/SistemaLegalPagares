@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-4">

    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">Sistema Legal de Pagarés</h2>
            <p class="text-muted">Gestión de documentos legales de forma segura</p>
        </div>
    </div>

    <!-- Cards resumen -->
    <div class="row g-3">

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">Mis Pagarés</h5>
                    <p class="card-text text-muted">Administra tus documentos creados.</p>
                    <a class="btn btn-primary" href="/Pagares">Ver Pagarés</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">Crear Pagaré</h5>
                    <p class="card-text text-muted">Registra un nuevo pagaré legal.</p>
                    <a class="btn btn-success" href="/Pagares/Create">Crear</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">Perfil</h5>
                    <p class="card-text text-muted">Revisa tu información de usuario.</p>
                    <a class="btn btn-secondary" href="/Identity/Account/Manage">Ver perfil</a>
                </div>
            </div>
        </div>

    </div>

</div>










