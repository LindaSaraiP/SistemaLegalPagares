@model SistemaLegalPagares.Models.Pagare

@{
    ViewData["Title"] = "Details";
}

<div class="container mt-4">

    <div class="row mb-3">
        <div class="col">
            <h2 class="fw-bold">Detalle del Pagaré</h2>
            <p class="text-muted">Documento legal completo</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.NumeroExpediente)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NumeroExpediente)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.Monto)
                </dt>
                <dd class="col-sm-9">
                    <span class="fw-bold text-success">
                        $@Html.DisplayFor(model => model.Monto)
                    </span>
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.NombreBeneficiario)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NombreBeneficiario)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.NombreSuscriptor)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NombreSuscriptor)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.LugarPago)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.LugarPago)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.FechaPago)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.FechaPago)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.LugarSuscripcion)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.LugarSuscripcion)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.FechaSuscripcion)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.FechaSuscripcion)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.FirmaSuscriptor)
                </dt>
                <dd class="col-sm-9">
                    <div class="border rounded p-2 bg-light">
                        @Html.DisplayFor(model => model.FirmaSuscriptor)
                    </div>
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.UsuarioId)
                </dt>
                <dd class="col-sm-9 text-break">
                    @Html.DisplayFor(model => model.UsuarioId)
                </dd>

            </dl>

            <hr />

            <div class="d-flex justify-content-between">

                <a asp-action="Index" class="btn btn-secondary">
                    Back to List
                </a>

                <div>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">
                        Delete
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>