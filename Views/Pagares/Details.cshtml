@model SistemaLegalPagares.Models.Pagare

@{
    ViewData["Title"] = "Vista Previa del Pagaré";
}

<div class="pagare-formitec">

    <table class="pagare-tabla">

        <tr class="pagare-header">

            <td rowspan="2" style="width:170px">
                <div class="pagare-titulo">
                    PAGARÉ
                </div>

                <div class="mt-3">
                    No. @(Model.NumeroPagare ?? "1 de 1")
                </div>
            </td>

            <td>
                LUGAR DE EXPEDICIÓN
            </td>

            <td>DÍA</td>
            <td>MES</td>
            <td>AÑO</td>

            <td>
                BUENO POR
            </td>

        </tr>

        <tr>

            <td>
                @Model.LugarExpedicion
            </td>

            <td>
                @Model.FechaExpedicion.Day
            </td>

            <td>
                @Model.FechaExpedicion.Month
            </td>

            <td>
                @Model.FechaExpedicion.Year
            </td>

            <td class="pagare-monto">
                $@Model.MontoTotal.ToString("N2")
            </td>

        </tr>

    </table>

    <br />

    <p class="texto-pagare">

        Debo(emos) y pagaré(mos) incondicionalmente sin pretexto este pagaré
        en el lugar y fechas citadas donde elija el tenedor el día de su
        vencimiento a la orden de

        <span class="campo">
            @Model.Beneficiario
        </span>

        en

        <span class="campo">
            @Model.LugarPagoPagare
        </span>

        el día

        <span class="campo">
            @Model.FechaVencimiento.Day
        </span>

        de

        <span class="campo">
            @Model.FechaVencimiento.Month
        </span>

        de

        <span class="campo">
            @Model.FechaVencimiento.Year
        </span>

    </p>

    <h4>
        La cantidad de:
    </h4>

    <div class="cantidad-box">

        @Model.MontoLetra

    </div>

    <br />

    <p class="texto-legal">

        VALOR RECIBIDO A MI (NUESTRA) ENTERA SATISFACCIÓN,
        ESTE PAGARE FORMA PARTE DE UNA SERIE NUMERADA DEL

        <strong>@Model.SerieDesde</strong>

        AL

        <strong>@Model.SerieHasta</strong>

        Y TODOS ESTAN SUJETOS A LA CONDICIÓN DE QUE DE NO PAGARSE
        CUALQUIERA DE ELLOS A SU VENCIMIENTO, SERÁN EXIGIBLES TODOS
        LOS QUE LE SIGUEN EN NÚMERO.

        ADEMÁS DE LOS YA VENCIDOS DE ACUERDO AL ART. 79 DE LA LEY
        GENERAL DE TÍTULOS Y OPERACIONES DE CRÉDITO.

        CAUSARÁN INTERESES MORATORIOS DEL

        <strong>@Model.InteresMoratorio %</strong>

        POR CADA MES O FRACCIÓN PAGADERO JUNTAMENTE CON EL PRINCIPAL.

        DICHOS INTERESES SE CAUSARÁN SOBRE EL CAPITAL INSOLUTO
        CONFORME A LO DISPUESTO POR EL ART. 152 INCISO I, II, III Y IV
        DE LA LEY GENERAL DE TÍTULOS Y OPERACIONES DE CRÉDITO.

    </p>

    <table class="pagare-tabla mt-4">

        <tr class="pagare-header">

            <td style="width:55%">
                NOMBRE Y DATOS DEL DEUDOR
            </td>

            <td style="width:20%">
                AVAL
            </td>

            <td style="width:25%">
                DEUDOR
            </td>

        </tr>

        <tr>

            <td>

                <br />

                <strong>NOMBRE:</strong>

                @Model.NombreSuscriptor

                <br /><br />

                <strong>DOMICILIO:</strong>

                @Model.DomicilioDeudor

                <br /><br />

                <strong>POBLACIÓN:</strong>

                @Model.PoblacionDeudor

                <br /><br />

            </td>

            <td>

                <div class="firma-box">

                    @if (!string.IsNullOrEmpty(Model.FirmaBase64))
                    {
                    <img src="@Model.FirmaBase64"
                         style="max-width:100%; max-height:100px;" />
                    }

                    <div class="firma-label">
                        FIRMA(S)
                    </div>

                </div>

            </td>

            <td>

                <div class="firma-box">

                    @if (!string.IsNullOrEmpty(Model.FirmaBase64))
                    {
                    <img src="@Model.FirmaBase64"
                         style="max-width:100%; max-height:100px;" />
                    }

                    <div class="firma-label">
                        FIRMA(S)
                    </div>

                </div>

            </td>

        </tr>

    </table>

</div>

<div class="text-center mt-4 no-print">

    <button type="button"
            onclick="window.print()"
            class="btn btn-success">
        Imprimir / Guardar como PDF
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</div>