@model SistemaLegalPagares.Models.Pagare

@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-4">

    <div class="row mb-3">
        <div class="col">
            <h2 class="fw-bold">Editar Pagaré</h2>
            <p class="text-muted">Modifica la información del documento legal</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="NumeroExpediente" class="form-label"></label>
                        <input asp-for="NumeroExpediente" class="form-control" />
                        <span asp-validation-for="NumeroExpediente" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Monto" class="form-label"></label>
                        <input asp-for="Monto" class="form-control" />
                        <span asp-validation-for="Monto" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NombreBeneficiario" class="form-label"></label>
                        <input asp-for="NombreBeneficiario" class="form-control" />
                        <span asp-validation-for="NombreBeneficiario" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NombreSuscriptor" class="form-label"></label>
                        <input asp-for="NombreSuscriptor" class="form-control" />
                        <span asp-validation-for="NombreSuscriptor" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LugarPago" class="form-label"></label>
                        <input asp-for="LugarPago" class="form-control" />
                        <span asp-validation-for="LugarPago" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FechaPago" class="form-label"></label>
                        <input asp-for="FechaPago" type="datetime-local" class="form-control" />
                        <span asp-validation-for="FechaPago" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LugarSuscripcion" class="form-label"></label>
                        <input asp-for="LugarSuscripcion" class="form-control" />
                        <span asp-validation-for="LugarSuscripcion" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FechaSuscripcion" class="form-label"></label>
                        <input asp-for="FechaSuscripcion" type="datetime-local" class="form-control" />
                        <span asp-validation-for="FechaSuscripcion" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="FirmaSuscriptor" class="form-label"></label>
                        <input asp-for="FirmaSuscriptor" class="form-control" />
                        <span asp-validation-for="FirmaSuscriptor" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="UsuarioId" class="form-label"></label>
                        <input asp-for="UsuarioId" class="form-control" readonly />
                        <span asp-validation-for="UsuarioId" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index" class="btn btn-secondary">
                        Back to List
                    </a>

                    <input type="submit" value="Save" class="btn btn-primary px-4" />

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}