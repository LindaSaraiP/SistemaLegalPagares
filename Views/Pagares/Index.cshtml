@model IEnumerable<SistemaLegalPagares.Models.Pagare>

    @{
    ViewData["Title"] = "Pagarés";
    }

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold">Pagarés</h2>
            <a class="btn btn-success" href="/Expedientes/Create">+ Nuevo Pagaré</a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Expediente</th>
                                <th>Monto</th>
                                <th>Beneficiario</th>
                                <th>Suscriptor</th>
                                <th>Fecha Pago</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                    {
                            <tr>
                                <td>@item.NumeroExpediente</td>
                                <td>$@item.Monto</td>
                                <td>@item.NombreBeneficiario</td>
                                <td>@item.NombreSuscriptor</td>
                                <td>@item.FechaPago?.ToString("yyyy-MM-dd")</td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm text-white">
                                        Ver pagaré
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-success btn-sm">
                                        Imprimir
                                    </a>
                                </td>
                            </tr>
                    }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>

    </div>
