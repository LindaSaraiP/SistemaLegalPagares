<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaLegalPagares</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaLegalPagares.styles.css" asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                     Sistema Legal
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <!-- MENÚ IZQUIERDO -->
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        <!-- EXPEDIENTES -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                Expedientes
                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Expedientes"
                                       asp-action="Index">

                                        Ver Expedientes
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Expedientes"
                                       asp-action="Create">

                                        Crear Expediente
                                    </a>
                                </li>

                            </ul>
                        </li>

                        <!-- PAGARÉS -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                Pagarés
                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Pagares"
                                       asp-action="Index">

                                        Lista de Pagarés
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Pagares"
                                       asp-action="Create">

                                        Crear Pagaré
                                    </a>
                                </li>

                            </ul>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold"
                               asp-controller="Admin"
                               asp-action="UsuariosPendientes">

                                 Panel Admin
                            </a>
                        </li>
                        }

                    </ul>

                    <!-- MENÚ DERECHO -->
                    <ul class="navbar-nav ms-auto">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                        <li class="nav-item">

                            <form asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  method="post"
                                  class="d-inline">

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">

                                     Cerrar sesión

                                </button>

                            </form>

                        </li>
                        }
                        else
                        {
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm"
                               asp-area="Identity"
                               asp-page="/Account/Login">

                                 Iniciar sesión
                            </a>
                        </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>

    </header>

    <!-- IMPORTANTE PARA QUE EL NAVBAR NO TAPE EL CONTENIDO -->
    <div class="container" style="margin-top:90px;">

        <main role="main" class="pb-4">
            @RenderBody()
        </main>

    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container py-3">

            &copy; 2026 - SistemaLegalPagares

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>